OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_URL=https://lecturacertificados.almia.com.co
MAX_FILE_SIZE_MB=10
PDF_ALWAYS_INCLUDE_IMAGES_FOR_OPENAI=true
ALLOW_ORIGINS=https://lecturacertificados.almia.com.co,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
ALLOW_ORIGIN_REGEX=^https://([a-zA-Z0-9-]+\.)?almia\.com\.co$|^https://[a-zA-Z0-9-]+\.vercel\.app$
REQUEST_TIMEOUT_SECONDS=90
ANALYSIS_DEBUG=false
MAX_PDF_PAGES_FOR_VISION=5
MAX_IMAGE_DIMENSION=1600
LOG_LEVEL=INFO
VITE_API_BASE_URL=http://localhost:8000
